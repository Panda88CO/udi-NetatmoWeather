<editors>
    <editor id="BOOL">
        <range uom="2" subset="0,1" />
    </editor>

    <editor id="TEMPERATURE">
        <range uom="17" min="-50" max="150" prec="1" />
    </editor>

    <editor id="CO2">
        <range uom="54" min="0" max="1000" prec="0" />
    </editor>

    <editor id="HUMIDITY">
        <range uom="22" min="0" max="100" prec="0" />
    </editor>

    <editor id="NOISE">
        <range uom="12" min="0" max="1000" prec="1" />
    </editor>

    <editor id="PRESSURE">
        <range uom="23" min="0" max="10000" prec="2" />
    </editor>

    <editor id="TREND">
        <range uom="25" subset="0-2" nls="ENTREND" />
    </editor>

    <editor id="TTIMESTAMP">
        <range uom="56" min="0" max="20000000000" prec="0" />
    </editor>

    <editor id="WIFIRFSTATUS">
        <range uom="56" min="0" max="100000" prec="0" />
    </editor>

    <editor id="PERCENT">
        <range uom="51" min="0" max="100" prec="0" />
    </editor>

    <editor id="RAIN">
        <range uom="23" min="0" max="100000" prec="3" />
    </editor>

    <editor id="WSTRENGTH">
        <range uom="48" min="0" max="1000" prec="0" />
    </editor>

    <editor id="WANGLE">
        <range uom="76" min="0" max="360" prec="0" />
    </editor>
</editors>
